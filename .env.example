# Настройки для запуска через Docker на своём компьютере (docker-compose.yml лежит рядом).
# Скопируйте файл в .env (cp .env.example .env) и заполните два значения.
# Файл .env содержит секреты: не отправляйте его в Git и никому не показывайте.
#
# Для публичного сервера используется другой файл: deploy/.env.example (см. deploy/README.md).

# Пароль базы данных. Создайте командой:  openssl rand -hex 24
# (только буквы a-f и цифры: так он безопасно встраивается в адрес подключения)
POSTGRES_PASSWORD=ЗАМЕНИТЕ

# Секретный ключ для подписи токенов входа. Создайте командой:  openssl rand -hex 32
JWT_SECRET_KEY=ЗАМЕНИТЕ
