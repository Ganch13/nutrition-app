# Образец настроек backend. Скопируйте файл в .env и подставьте свои значения.
# Файл .env содержит секреты и не попадает в Git.

# Секретный ключ для подписи токенов входа. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-with-a-long-random-string

# Адреса frontend, которым разрешено обращаться к API (через запятую)
CORS_ORIGINS=http://localhost:3000

# Подключение к базе (по умолчанию: локальный PostgreSQL, пользователь nutrition)
# DATABASE_URL=postgresql+psycopg2://nutrition:ПАРОЛЬ@localhost:5432/nutrition

# Папка для фото прогресса и максимальный размер одного фото, МБ
# UPLOAD_DIR=uploads
# MAX_PHOTO_MB=8

# --- Только для публичного сервера (там их задаёт deploy/docker-compose.prod.yml, см. deploy/README.md) ---
# ENVIRONMENT=production        # включает строгую проверку настроек, закрывает /docs, HSTS, cookie только по HTTPS
# ALLOWED_HOSTS=nutrition.example.com,localhost,127.0.0.1
# TRUST_PROXY_HEADERS=true      # верить X-Forwarded-For (только если backend доступен лишь через прокси)
# REFRESH_COOKIE_PATH=/api/auth # путь cookie сессии, если API открыт по адресу с префиксом /api
# REGISTRATION_OPEN=true        # false — закрыть регистрацию новых пользователей
# ENABLE_DOCS=false             # true — показывать /docs (только при разработке)
