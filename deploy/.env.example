# Настройки боевого сервера. Скопируйте в deploy/.env и заполните:  cp deploy/.env.example deploy/.env
# Файл .env содержит секреты: не отправляйте его в Git и никому не показывайте (chmod 600 deploy/.env).

# Домен сайта без https:// . В DNS должна быть A-запись на IP сервера
DOMAIN=nutrition.example.com

# Почта для уведомлений Let's Encrypt
ACME_EMAIL=you@example.com

# Пароль базы данных. Создайте командой:  openssl rand -hex 24
# (только буквы a-f и цифры: так он безопасно встраивается в адрес подключения)
POSTGRES_PASSWORD=ЗАМЕНИТЕ

# Секретный ключ для подписи токенов входа, не короче 32 символов. Создайте командой:  openssl rand -hex 32
JWT_SECRET_KEY=ЗАМЕНИТЕ

# Часовой пояс сервера для журналов и времени резервных копий
TZ=Europe/Moscow

# --- Необязательные настройки (можно не менять) ---

# Можно ли заводить новые аккаунты. Для публичного сервера: зарегистрируйте всех членов семьи,
# затем поставьте false и перезапустите (./deploy/deploy.sh). Вход и приглашения в семью продолжат работать.
REGISTRATION_OPEN=true

# Папка на сервере для резервных копий
BACKUP_DIR=/var/backups/nutrition
# Во сколько делать копию каждый день (по времени TZ)
BACKUP_TIME=03:30
# Сколько дней хранить ежедневные копии и сколько месяцев — копии первого числа
KEEP_DAILY_DAYS=14
KEEP_MONTHLY_MONTHS=6

# Максимальный размер одного фото прогресса, МБ
MAX_PHOTO_MB=8
