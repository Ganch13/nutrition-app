# Настройки ТОЛЬКО для локальной проверки (local/docker-compose.yml).
# Скрипт lad-local сам создаёт local/.env по этому образцу и подставляет случайные значения,
# поэтому вручную ничего делать не нужно. Боевые пароли и ключи сюда не вписывать.

# Пароль локальной базы (буквы a-f и цифры)
LOCAL_POSTGRES_PASSWORD=ЗАМЕНИТЕ

# Ключ подписи токенов для локального запуска (64 символа a-f и цифры)
LOCAL_JWT_SECRET_KEY=ЗАМЕНИТЕ
